# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.

# Vercel Postgres (auto-added when you connect a Postgres database in Vercel)
POSTGRES_URL=

# Random 32+ char string — used to sign login sessions. Generate: openssl rand -base64 32
JWT_SECRET=

# Admin password for the seed script (npm run seed). Min 8 chars.
ADMIN_PASSWORD=

# Protects /api/cron/weekly-summary — Vercel Cron sends this as a Bearer token.
# Generate: openssl rand -base64 32
CRON_SECRET=
